---
// Reads src/data/coauthors.csv, the same file the collaborator map on the community page uses.
import Page from '../../layouts/Page.astro';
import { loadCoauthors } from '../../lib/coauthors';

const coauthors = loadCoauthors().sort((a, b) => a.name.localeCompare(b.name));
const updated = new Date().toISOString().slice(0, 10);
---

<Page title="Coauthors in alphabetical order">
  <p>The following table includes the coauthors of ongoing and finished projects. <em>Indicates undergraduate RA coauthors.</em></p>
  <p><strong>Total coauthors:</strong> {coauthors.length} (updated {updated})</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Affiliation</th><th>Note</th></tr></thead>
      <tbody>
        {coauthors.map((c) => <tr><td>{c.name}</td><td>{c.affiliation}</td><td>{c.note}</td></tr>)}
      </tbody>
    </table>
  </div>
</Page>
